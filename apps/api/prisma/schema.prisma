generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum FamilyRole {\n  OWNER\n  ADMIN\n  MEMBER\n}\n\nenum ShoppingListStatus {\n  DRAFT\n  ACTIVE\n  COMPLETED\n  ARCHIVED\n}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships FamilyMember[]
  sessions AuthSession[]
  shoppingLists ShoppingList[] @relation("ListCreator")
  recordedPrices ProductPrice[] @relation("PriceRecorder")
  @@map("users")
}
model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  refreshTokenHash String @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}
model Family {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  currencyCode String @default("COP") @map("currency_code") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  members FamilyMember[]
  products FamilyProduct[]
  supermarkets FamilySupermarket[]
  shoppingLists ShoppingList[]
  productPrices ProductPrice[]
  @@map("families")
}
model FamilyMember {
  id String @id @default(uuid()) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role FamilyRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  products Product[]
  @@map("categories")
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(180)
  description String? @db.Text
  categoryId String? @map("category_id") @db.Uuid
  baseUnit String @map("base_unit") @db.VarChar(16)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  familyProducts FamilyProduct[]
  shoppingItems ShoppingListItem[]
  prices ProductPrice[]
  @@index([name])
  @@index([categoryId])
  @@map("products")
}
model FamilyProduct {
  id String @id @default(uuid()) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([familyId, productId])
  @@map("family_products")
}
model Supermarket {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  countryCode String @default("CO") @map("country_code") @db.Char(2)
  website String? @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  families FamilySupermarket[]
  prices ProductPrice[]
  @@index([name])
  @@map("supermarkets")
}
model FamilySupermarket {
  id String @id @default(uuid()) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  supermarketId String @map("supermarket_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  supermarket Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Restrict)
  @@unique([familyId, supermarketId])
  @@map("family_supermarkets")
}
model ShoppingList {
  id String @id @default(uuid()) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid
  name String @db.VarChar(150)
  status ShoppingListStatus @default(DRAFT)
  currencyCode String @default("COP") @map("currency_code") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items ShoppingListItem[]
  @@index([familyId, status])
  @@map("shopping_lists")
}
model ShoppingListItem {
  id String @id @default(uuid()) @db.Uuid
  shoppingListId String @map("shopping_list_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Decimal @db.Decimal(12, 3)
  quantityUnit String @map("quantity_unit") @db.VarChar(16)
  checked Boolean @default(false)
  sortOrder Int @default(0) @map("sort_order")
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices ProductPrice[]
  @@index([shoppingListId, sortOrder])
  @@index([productId])
  @@map("shopping_list_items")
}
model ProductPrice {
  id String @id @default(uuid()) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  supermarketId String @map("supermarket_id") @db.Uuid
  shoppingListItemId String? @map("shopping_list_item_id") @db.Uuid
  price Decimal @db.Decimal(14, 2)
  currencyCode String @default("COP") @map("currency_code") @db.Char(3)
  packageQuantity Decimal @default(1) @map("package_quantity") @db.Decimal(12, 3)
  packageUnit String @default("unit") @map("package_unit") @db.VarChar(16)
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
  recordedById String? @map("recorded_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  supermarket Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Restrict)
  shoppingListItem ShoppingListItem? @relation(fields: [shoppingListItemId], references: [id], onDelete: SetNull)
  recordedBy User? @relation("PriceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  @@index([familyId, productId, supermarketId, observedAt])
  @@index([shoppingListItemId, supermarketId])
  @@index([familyId, observedAt])
  @@map("product_prices")
}
