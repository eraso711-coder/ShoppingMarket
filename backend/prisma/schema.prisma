generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

enum ShoppingListStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PriceSource {
  MANUAL
  RECEIPT
  IMPORT
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String         @unique @db.VarChar(255)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  familyMembers  FamilyMember[]
  createdLists   ShoppingList[] @relation("ListCreator")
  recordedPrices ProductPrice[] @relation("PriceRecorder")
  @@map("users")
}

model Family {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(150)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  members        FamilyMember[]
  products       FamilyProduct[]
  supermarkets   FamilySupermarket[]
  shoppingLists  ShoppingList[]
  prices         ProductPrice[]
  @@map("families")
}

model FamilyMember {
  id       String     @id @default(uuid()) @db.Uuid
  familyId String     @map("family_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products  Product[]
  @@map("categories")
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(200)
  brand       String?         @db.VarChar(120)
  description String?
  categoryId  String?         @map("category_id") @db.Uuid
  baseUnit    String?         @map("base_unit") @db.VarChar(30)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  families    FamilyProduct[]
  listItems   ShoppingListItem[]
  prices      ProductPrice[]
  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model FamilyProduct {
  id        String  @id @default(uuid()) @db.Uuid
  familyId  String  @map("family_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")
  family    Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([familyId, productId])
  @@map("family_products")
}

model Supermarket {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @unique @db.VarChar(150)
  website   String?             @db.VarChar(500)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  families  FamilySupermarket[]
  prices    ProductPrice[]
  @@map("supermarkets")
}

model FamilySupermarket {
  id            String      @id @default(uuid()) @db.Uuid
  familyId      String      @map("family_id") @db.Uuid
  supermarketId String      @map("supermarket_id") @db.Uuid
  isActive      Boolean     @default(true) @map("is_active")
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  @@unique([familyId, supermarketId])
  @@map("family_supermarkets")
}

model ShoppingList {
  id          String             @id @default(uuid()) @db.Uuid
  familyId    String             @map("family_id") @db.Uuid
  createdById String             @map("created_by_id") @db.Uuid
  name        String             @db.VarChar(160)
  status      ShoppingListStatus @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("ListCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       ShoppingListItem[]
  @@index([familyId, status])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String       @id @default(uuid()) @db.Uuid
  shoppingListId String       @map("shopping_list_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  quantity       Decimal      @default(1) @db.Decimal(12, 3)
  unit           String?      @db.VarChar(30)
  isChecked      Boolean      @default(false) @map("is_checked")
  notes          String?
  position       Int          @default(0)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices         ProductPrice[]
  @@index([shoppingListId, position])
  @@map("shopping_list_items")
}

model ProductPrice {
  id                 String            @id @default(uuid()) @db.Uuid
  familyId           String            @map("family_id") @db.Uuid
  productId          String            @map("product_id") @db.Uuid
  supermarketId      String            @map("supermarket_id") @db.Uuid
  shoppingListItemId String?           @map("shopping_list_item_id") @db.Uuid
  recordedById       String            @map("recorded_by_id") @db.Uuid
  price              Decimal           @db.Decimal(12, 2)
  currency           String            @default("COP") @db.VarChar(3)
  packageQuantity    Decimal?          @map("package_quantity") @db.Decimal(12, 3)
  packageUnit        String?           @map("package_unit") @db.VarChar(30)
  source             PriceSource       @default(MANUAL)
  observedAt         DateTime          @default(now()) @map("observed_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  family             Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  supermarket        Supermarket       @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  shoppingListItem   ShoppingListItem? @relation(fields: [shoppingListItemId], references: [id], onDelete: SetNull)
  recordedBy         User              @relation("PriceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([familyId, productId, supermarketId, observedAt(sort: Desc)])
  @@index([shoppingListItemId])
  @@map("product_prices")
}
