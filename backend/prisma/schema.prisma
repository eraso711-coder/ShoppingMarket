generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}
enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}
enum ShoppingListItemStatus {
  TO_BUY
  IN_CART
  PURCHASED
  UNAVAILABLE
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")
  firstName    String @map("first_name")
  lastName     String @map("last_name")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  memberships  FamilyMember[]
  createdLists ShoppingList[] @relation("ListCreator")
  listItems    ShoppingListItem[] @relation("ItemAddedBy")
  @@map("users")
}

model Family {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  memberships FamilyMember[]
  lists       ShoppingList[]
  @@map("families")
}

model FamilyMember {
  id       String @id @default(uuid()) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")
  family   Family @relation(fields:[familyId],references:[id],onDelete:Cascade)
  user     User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([familyId,userId])
  @@index([userId])
  @@map("family_members")
}

model Category {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique
  parentId  String? @map("parent_id") @db.Uuid
  parent    Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime @default(now()) @map("created_at")
  @@map("categories")
}

model Product {
  id                String @id @default(uuid()) @db.Uuid
  name              String
  brand             String?
  barcode           String? @unique
  description       String?
  categoryId        String? @map("category_id") @db.Uuid
  category          Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  unit              String?
  quantity          Decimal? @db.Decimal(10,3)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  supermarketOffers SupermarketProduct[]
  priceObservations PriceObservation[]
  listItems         ShoppingListItem[]
  @@index([name])
  @@index([brand])
  @@map("products")
}

model Supermarket {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  chain     String?
  website   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  offers    SupermarketProduct[]
  prices    PriceObservation[]
  @@unique([name,chain])
  @@map("supermarkets")
}

model SupermarketProduct {
  id            String @id @default(uuid()) @db.Uuid
  supermarketId String @map("supermarket_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  externalCode  String? @map("external_code")
  productUrl    String? @map("product_url")
  isAvailable   Boolean @default(true) @map("is_available")
  supermarket   Supermarket @relation(fields:[supermarketId],references:[id],onDelete:Cascade)
  product       Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@unique([supermarketId,productId])
  @@index([productId])
  @@map("supermarket_products")
}

model PriceObservation {
  id            String @id @default(uuid()) @db.Uuid
  productId     String @map("product_id") @db.Uuid
  supermarketId String @map("supermarket_id") @db.Uuid
  price         Decimal @db.Decimal(10,2)
  currency      String @default("EUR") @db.VarChar(3)
  observedAt    DateTime @default(now()) @map("observed_at")
  source        String?
  product       Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  supermarket   Supermarket @relation(fields:[supermarketId],references:[id],onDelete:Cascade)
  @@index([productId,observedAt])
  @@index([supermarketId,observedAt])
  @@map("price_observations")
}

model ShoppingList {
  id          String @id @default(uuid()) @db.Uuid
  familyId    String @map("family_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  name        String
  status      ShoppingListStatus @default(ACTIVE)
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  family      Family @relation(fields:[familyId],references:[id],onDelete:Cascade)
  createdBy   User @relation("ListCreator",fields:[createdById],references:[id],onDelete:Restrict)
  items       ShoppingListItem[]
  @@index([familyId,status])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String @id @default(uuid()) @db.Uuid
  shoppingListId String @map("shopping_list_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  addedById      String @map("added_by_id") @db.Uuid
  customName     String? @map("custom_name")
  quantity       Decimal @default(1) @db.Decimal(10,3)
  notes          String?
  status         ShoppingListItemStatus @default(TO_BUY)
  sortOrder      Int @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  shoppingList   ShoppingList @relation(fields:[shoppingListId],references:[id],onDelete:Cascade)
  product        Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
  addedBy        User @relation("ItemAddedBy",fields:[addedById],references:[id],onDelete:Restrict)
  @@index([shoppingListId,status,sortOrder])
  @@index([productId])
  @@map("shopping_list_items")
}
